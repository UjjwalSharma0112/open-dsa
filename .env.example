# Copy to .env and fill in your values (see README "Environment").
# Do not commit the real .env.

# Required: Gemini API key. The app refuses to talk to the model without it.
GOOGLE_API_KEY=

# Optional: selected Gemini model.
# Precedence: GEMINI_MODEL > --model > config.toml [app].default_model > gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash